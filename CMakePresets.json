{
  "version": 6,
  "configurePresets": [
    {
      "name": "core",
      "displayName": "Portable core and deterministic tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/core",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OPENNVR_BUILD_MEDIA": "OFF",
        "OPENNVR_BUILD_DESKTOP": "OFF",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Windows development (Qt and GStreamer on prefix path)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "core", "configurePreset": "core" },
    { "name": "dev", "configurePreset": "dev" }
  ],
  "testPresets": [
    { "name": "core", "configurePreset": "core", "output": { "outputOnFailure": true } },
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } }
  ]
}
